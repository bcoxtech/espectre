"""
Micro-ESPectre Local Configuration Template
Copy this file to config_local.py and update with your settings
(config_local.py overrides defaults from config.py and is gitignored for security)

Author: Francesco Pace <francesco.pace@gmail.com>
License: GPLv3
"""

# WiFi Configuration
WIFI_SSID = "YourSSID"
WIFI_PASSWORD = "YourPassword"
# Optional AP lock (helps on mesh networks)
# WIFI_BSSID = "AA:BB:CC:DD:EE:FF"

# MQTT Configuration
MQTT_BROKER = "homeassistant.local"  # Your MQTT broker IP or hostname
MQTT_PORT = 1883
MQTT_USERNAME = "username"
MQTT_PASSWORD = "password"

# Control Plane Configuration (only used if deployed with `./me deploy --control-plane`)
# IP of the host running the control listener (e.g. espectre_ctl.py on the Pi relay)
CONTROL_HOST = "192.168.0.7"
CONTROL_PORT = 5002

# On-device display + local start/stop button (only on boards with the
# hardware - e.g. Waveshare ESP32-S3-LCD-1.47). Leave both commented out /
# None on boards without this hardware.
# DISPLAY_DRIVER = "st7789_waveshare147"
# TRIGGER_DRIVER = "gpio_button"
